# PRODUCT
NEXT_PUBLIC_APP_NAME=Opsora
NEXT_PUBLIC_APP_URL=https://opsora.cubixtop.com
APP_PRODUCTION_URL=https://opsora.cubixtop.com
APP_TIMEZONE=Asia/Kolkata

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DEFAULT ADMIN
INITIAL_SUPER_ADMIN_NAME=Opsora Administrator
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_SUPER_ADMIN_FORCE_PASSWORD_CHANGE=false
ENABLE_PUBLIC_REGISTRATION=false

# WEB PUSH
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://opsora.cubixtop.com

# SERVER SECURITY
CRON_SECRET=
# Random value containing at least 32 characters. Do not rotate without
# re-entering saved SMTP credentials in every organization.
APP_ENCRYPTION_KEY=

# FEATURES
ENABLE_WEB_PUSH=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_RECURRING_TASKS=true
ENABLE_MANUAL_ACTIVITY_LOGS=true
ENABLE_REPORT_SCHEDULING=true
ENABLE_AI_FEATURES=false

# STORAGE
MAX_IMAGE_UPLOAD_MB=10
MAX_DOCUMENT_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=50
REPORT_SIGNED_URL_EXPIRY_SECONDS=900
